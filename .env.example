# Copy to .env and replace these placeholders with your team's development values.
# Do not commit .env or paste your API key into the frontend configuration.
WORKOS_CLIENT_ID=client_replace_with_team_client_id
WORKOS_API_KEY=sk_test_replace_with_team_api_key
MONGODB_URI=mongodb+srv://user:password@cluster.example.net/energystart
# Optional: leave empty to use the backend's standard WorkOS issuer.
WORKOS_ISSUER=
